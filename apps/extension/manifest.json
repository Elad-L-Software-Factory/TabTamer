{
  "manifest_version": 3,
  "name": "TabTamer Browser Helper",
  "short_name": "TabTamer",
  "version": "0.3.0",
  "description": "Lets the TabTamer app see and tidy your tabs. Works only with the TabTamer app installed on your PC.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "nativeMessaging", "alarms", "tabGroups", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TabTamer",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "key": ""
}
