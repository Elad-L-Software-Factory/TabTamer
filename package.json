{
  "name": "tabtamer",
  "private": true,
  "description": "TabTamer (by Elad Lavi): an AI agent in your Windows tray that tames Chrome and Edge tabs",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dev": "pnpm --filter @tabtamer/extension run build && pnpm --filter @tabtamer/desktop run dev",
    "smoke": "node apps/desktop/scripts/smoke-edge.mjs",
    "register-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-native-host.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
